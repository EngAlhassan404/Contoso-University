@model ContosoUniversity.Models.Student

@{
    ViewData["Title"] = "تأكيد حذف الطالب | Delete Student";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold mb-0 text-danger d-flex align-items-center gap-2">
                <span>⚠️</span>
                <span>تأكيد حذف سجل الطالب</span>
            </h3>
            <a asp-action="Index" class="btn-brand-outline">
                <span>&rarr;</span>
                <span>العودة للقائمة</span>
            </a>
        </div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                <span class="fs-4">🚨</span>
                <div>@ViewData["ErrorMessage"]</div>
            </div>
        }

        <div class="luxury-card p-4 mb-4" style="border-top: 4px solid var(--brand-danger);">
            <div class="text-center py-2 mb-3">
                <div class="display-3 mb-2">🗑️</div>
                <h4 class="fw-bold text-dark">هل أنت متأكد من رغبتك في حذف هذا الطالب؟</h4>
                <p class="text-muted small">هذا الإجراء سيقوم بحذف سجل الطالب وكافة التسجيلات والمقررات المرتبطة به.</p>
            </div>

            <div class="p-3 rounded-3 mb-4" style="background: var(--brand-surface-warm); border: 1px solid var(--brand-border);">
                <div class="row gy-2">
                    <div class="col-sm-4 text-muted">الاسم الكامل:</div>
                    <div class="col-sm-8 fw-bold text-dark">@Model.FirstMidName @Model.LastName</div>

                    <div class="col-sm-4 text-muted">المعرف الأكاديمي:</div>
                    <div class="col-sm-8 fw-bold text-dark">#@Model.ID</div>

                    <div class="col-sm-4 text-muted">تاريخ التسجيل:</div>
                    <div class="col-sm-8 fw-bold text-dark">@Model.EnrollmentDate.ToString("yyyy-MM-dd")</div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="ID" />
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-danger px-4 py-2 fw-bold" style="border-radius: var(--radius-md);">
                        <span>🗑️ نعم، تأكيد الحذف</span>
                    </button>
                    <a asp-action="Index" class="btn-brand-soft px-4 py-2">
                        <span>إلغاء والتراجع</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
