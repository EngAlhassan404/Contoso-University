@model ContosoUniversity.Models.Student

@{
    ViewData["Title"] = "إضافة طالب جديد | Create Student";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold mb-0 d-flex align-items-center gap-2">
                <span>➕</span>
                <span>إضافة طالب جديد بالسجل</span>
            </h3>
            <a asp-action="Index" class="btn-brand-outline">
                <span>&rarr;</span>
                <span>العودة للقائمة</span>
            </a>
        </div>

        <div class="form-card card-accent-top">
            <p class="text-muted small mb-4">
                يرجى إدخال البيانات الأكاديمية للطالب؛ النظام محمي تلقائياً ضد هجمات الـ Overposting.
            </p>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FirstMidName" class="form-label d-flex align-items-center gap-1">
                        <span>👤</span>
                        <span>الاسم الأول (First &amp; Middle Name):</span>
                    </label>
                    <input asp-for="FirstMidName" class="form-control" placeholder="مثال: محمد، علي، أحمد..." />
                    <span asp-validation-for="FirstMidName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label d-flex align-items-center gap-1">
                        <span>🏷️</span>
                        <span>اللقب / اسم العائلة (Last Name):</span>
                    </label>
                    <input asp-for="LastName" class="form-control" placeholder="مثال: باحبه، العمودي، باوزير..." />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="EnrollmentDate" class="form-label d-flex align-items-center gap-1">
                        <span>📅</span>
                        <span>تاريخ الالتحاق والتسجيل (Enrollment Date):</span>
                    </label>
                    <input asp-for="EnrollmentDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EnrollmentDate" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-brand-primary">
                        <span>💾</span>
                        <span>حفظ بيانات الطالب</span>
                    </button>
                    <a asp-action="Index" class="btn-brand-soft">
                        <span>إلغاء</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
