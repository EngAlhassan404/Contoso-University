@model IEnumerable<ContosoUniversity.Models.Student>

@{
    ViewData["Title"] = "إدارة الطلاب | Students List";
}

<!-- Page Header & Action Bar -->
<div class="luxury-card p-4 mb-4">
    <div class="row align-items-center gy-3">
        <div class="col-md-6">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background: #FAF3EC; color: var(--brand-caramel); font-size: 1.8rem;">
                    👨‍🎓
                </div>
                <div>
                    <h3 class="mb-1 fw-bold">سجل الطلاب الأكاديمي</h3>
                    <p class="text-muted small mb-0">
                        استعراض وإدارة بيانات الطلاب المسجلين والتحكم بعمليات CRUD بأمان
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 text-md-end">
            <a asp-action="Create" class="btn-brand-primary">
                <span>➕</span>
                <span>إضافة طالب جديد</span>
            </a>
        </div>
    </div>

    <hr class="my-3" style="border-color: var(--brand-border);" />

    <!-- Live Search & Filter Bar -->
    <div class="row align-items-center gy-2">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0" style="border-color: var(--brand-border); font-size: 1.1rem;">
                    🔍
                </span>
                <input type="text" id="studentSearchInput" class="form-control border-start-0 ps-0" 
                       placeholder="ابحث بالاسم الأول أو اللقب..." aria-label="بحث عن طالب" />
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            <span class="badge" style="background: var(--brand-surface-warm); color: var(--brand-brown-mid); border: 1px solid var(--brand-border); padding: 8px 14px; font-size: 0.85rem; border-radius: 50px;">
                📊 إجمالي الطلاب: <strong id="studentCountBadge">@Model.Count()</strong> طالب
            </span>
        </div>
    </div>
</div>

<!-- Students Data Table -->
<div class="custom-table-container mb-4">
    <div class="table-responsive">
        <table class="table table-custom align-middle" id="studentsTable">
            <thead>
                <tr>
                    <th scope="col" style="width: 32%;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span>👤</span>
                            <span>اسم الطالب (Student Name)</span>
                        </span>
                    </th>
                    <th scope="col" style="width: 28%;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span>📅</span>
                            <span>تاريخ التسجيل (Enrollment Date)</span>
                        </span>
                    </th>
                    <th scope="col" class="text-center" style="width: 40%;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span>⚙️</span>
                            <span>الإجراءات والعمليات (Actions)</span>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    var initials = !string.IsNullOrEmpty(item.FirstMidName) ? item.FirstMidName.Substring(0, 1) : "S";
                    var isSpecial = item.LastName != null && item.LastName.Contains("Bahbah");
                    <tr class="student-row">
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="student-avatar" style="@(isSpecial ? "background: linear-gradient(135deg, #2E6F40, #4D7C59);" : "")">
                                    @(isSpecial ? "⭐" : initials)
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">
                                        @Html.DisplayFor(modelItem => item.LastName), @Html.DisplayFor(modelItem => item.FirstMidName)
                                    </div>
                                    @if (isSpecial) {
                                        <span class="badge bg-success small" style="font-size: 0.72rem;">مهندس ومطور النظام 💻</span>
                                    } else {
                                        <span class="text-muted small">معرّف الطالب: #@item.ID</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">🗓️</span>
                                <span class="fw-medium">@item.EnrollmentDate.ToString("yyyy-MM-dd")</span>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-2 flex-wrap justify-content-center">
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn-action-edit" title="تعديل بيانات الطالب">
                                    <span>✏️</span>
                                    <span>تعديل</span>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn-action-details" title="عرض تفاصيل المقررات والدرجات">
                                    <span>👁️</span>
                                    <span>تفاصيل</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn-action-delete" title="حذف الطالب">
                                    <span>🗑️</span>
                                    <span>حذف</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Empty Search State -->
<div id="noResultsAlert" class="luxury-card p-5 text-center d-none">
    <div class="display-3 mb-2">🔍</div>
    <h4 class="text-muted fw-bold">لم يتم العثور على طالب يطابق معايير البحث</h4>
    <p class="text-muted small">يرجى التأكد من كتابة الاسم بصورة صحيحة أو مسح البحث</p>
    <button class="btn-brand-soft mt-2" onclick="document.getElementById('studentSearchInput').value=''; filterStudents();">
        إعادة تعيين البحث 🔄
    </button>
</div>

@section Scripts {
<script>
    function filterStudents() {
        var input = document.getElementById('studentSearchInput').value.toLowerCase().trim();
        var rows = document.querySelectorAll('.student-row');
        var visibleCount = 0;

        rows.forEach(function(row) {
            var text = row.textContent.toLowerCase();
            if (text.includes(input)) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('studentCountBadge').textContent = visibleCount;
        var emptyAlert = document.getElementById('noResultsAlert');
        if (visibleCount === 0) {
            emptyAlert.classList.remove('d-none');
        } else {
            emptyAlert.classList.add('d-none');
        }
    }

    document.getElementById('studentSearchInput').addEventListener('input', filterStudents);
</script>
}
