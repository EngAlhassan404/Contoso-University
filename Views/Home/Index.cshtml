@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-4">
        <h1 class="display-5 fw-bold text-primary">Contoso University</h1>
        <p class="col-md-8 fs-4">
            Demonstrating Entity Framework Core in an ASP.NET Core MVC web application.
        </p>
        <div class="alert alert-info d-inline-block py-2 px-3">
            <strong>Project Developer:</strong> Eng.Alhassan Ali Bahbah
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-primary">Welcome to Contoso University</h4>
                <p class="card-text">
                    Contoso University is a sample application that demonstrates how to use Entity Framework Core in an ASP.NET Core MVC web application.
                </p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a class="btn btn-outline-primary" asp-controller="Students" asp-action="Index">Manage Students &raquo;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-success">Build it from scratch</h4>
                <p class="card-text">
                    This project is built according to the official Microsoft Learn tutorial for EF Core in ASP.NET Core MVC.
                </p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a class="btn btn-outline-success" href="https://learn.microsoft.com/en-us/aspnet/core/data/ef-mvc/intro" target="_blank">See Tutorial &raquo;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-secondary">Verified & Configured</h4>
                <p class="card-text">
                    Fully structured, validated, and seeded with initial data including Eng.Alhassan Ali Bahbah as a registered student.
                </p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="About">About Project &raquo;</a>
            </div>
        </div>
    </div>
</div>
