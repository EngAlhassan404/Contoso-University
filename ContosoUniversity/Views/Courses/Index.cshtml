@model IEnumerable<ContosoUniversity.Models.Course>

@{
    ViewData["Title"] = "المقررات الدراسية | Courses Directory";
}

<!-- Courses Header -->
<div class="luxury-card p-4 mb-4">
    <div class="row align-items-center gy-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background: #FAF3EC; color: var(--brand-caramel); font-size: 1.8rem;">
                    📚
                </div>
                <div>
                    <h3 class="mb-1 fw-bold">دليل المقررات الأكاديمية</h3>
                    <p class="text-muted small mb-0">
                        قائمة المقررات المعتمدة، الساعات الدراسية، والرموز الأكاديمية بكلية الهندسة
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            <span class="badge" style="background: var(--brand-surface-warm); color: var(--brand-brown-mid); border: 1px solid var(--brand-border); padding: 8px 16px; font-size: 0.9rem; border-radius: 50px;">
                📖 عدد المقررات: <strong>@Model.Count()</strong> مقرر
            </span>
        </div>
    </div>
</div>

<!-- Courses Grid & Table -->
<div class="custom-table-container mb-4">
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th style="width: 20%;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span>🔢</span>
                            <span>رقم المقرر (Course ID)</span>
                        </span>
                    </th>
                    <th style="width: 50%;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span>📘</span>
                            <span>عنوان المقرر الدراسي (Course Title)</span>
                        </span>
                    </th>
                    <th class="text-center" style="width: 30%;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span>⏱️</span>
                            <span>الساعات المعتمدة (Credits)</span>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>
                            <span class="badge" style="background: var(--brand-surface-warm); color: var(--brand-chestnut); border: 1px solid var(--brand-border); font-size: 0.88rem; padding: 6px 12px;">
                                #@item.CourseID
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5">📖</span>
                                <span class="fw-bold text-dark fs-6">@item.Title</span>
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="badge" style="background: #FDF4E6; color: var(--brand-caramel); border: 1px solid #E8C18C; font-size: 0.85rem; padding: 6px 14px; border-radius: 50px;">
                                🌟 @item.Credits ساعات دراسية
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
